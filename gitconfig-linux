[core]
  excludesfile = ~/.gitignore
  pager = diff-so-fancy | less --tabs=4 -RFX
[credential]
  format = ssh
[pager]
  diff = diff-so-fancy | less --tabs=4 -RFXS --pattern '^(Date|added|deleted|modified): '
# WSL-only settings; the file is only linked on WSL and git skips missing includes
[include]
  path = ~/.gitconfig-wsl
